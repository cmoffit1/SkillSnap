<section class="project-section" aria-labelledby="project-list-heading">
    <div class="section-heading">
        <p class="eyebrow">Selected work</p>
        <h2 id="project-list-heading">Projects</h2>
    </div>

    @if (Projects.Count == 0)
    {
        <p class="empty-state">No projects to show yet.</p>
    }
    else
    {
        <div class="project-grid">
            @foreach (var project in Projects)
            {
                <article class="project-card">
                    @if (!string.IsNullOrWhiteSpace(project.ImageUrl))
                    {
                        <img class="project-image" src="@project.ImageUrl" alt="" loading="lazy" />
                    }
                    <div class="project-copy">
                        <h3>@project.Title</h3>
                        <p>@project.Description</p>
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    [Parameter]
    public IReadOnlyList<ProjectDisplayModel> Projects { get; set; } = Array.Empty<ProjectDisplayModel>();
}
