@page "/projects/{Id:int}"
@using SkillSnap.Client.Services
@inject ProjectService ProjectService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<ProjectDetail> Logger

<PageTitle>@(_project?.Title ?? "Project") | SkillSnap</PageTitle>

<main class="container py-4">
    <a class="btn btn-outline-primary mb-3" href="projects?page=@(PageParameter ?? 1)" aria-label="Back to projects">
        <span aria-hidden="true">&larr;</span> Back
    </a>

    <AuthorizeView>
        <NotAuthorized>
            <p class="text-secondary">Sign in to view this project.</p>
        </NotAuthorized>
        <Authorized Context="_">
            @if (_isLoading)
            {
                <p role="status">Loading project…</p>
            }
            else if (_errorMessage is not null)
            {
                <ErrorAlert Message="@_errorMessage" OnRetry="LoadAsync" />
            }
            else if (_project is null)
            {
                <p class="text-secondary">That project doesn't exist.</p>
            }
            else
            {
                <article class="card shadow-sm">
                    <div class="card-body">
                        <h1 class="card-title h3">@_project.Title</h1>
                        <p class="card-text">@_project.Description</p>
                        @if (!string.IsNullOrWhiteSpace(_project.ImageUrl))
                        {
                            <p class="card-text mb-0">
                                @if (SafeUrl(_project.ImageUrl) is { } url)
                                {
                                    <a href="@url" target="_blank" rel="noopener noreferrer">@_project.ImageUrl</a>
                                }
                                else
                                {
                                    @_project.ImageUrl
                                }
                            </p>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_project.ImageUrl))
                    {
                        <img class="card-img-bottom" src="@_project.ImageUrl" alt="" />
                    }
                </article>

                <AuthorizeView Roles="Admin">
                    <div class="d-flex gap-2 mt-3">
                        <a class="btn btn-outline-primary @(_isDeleting ? "disabled" : null)"
                           href="projects/@Id/edit?page=@(PageParameter ?? 1)">Edit</a>
                        <button class="btn btn-outline-danger" type="button" disabled="@_isDeleting"
                                @onclick="DeleteAsync">
                            @(_isDeleting ? "Deleting…" : "Delete")
                        </button>
                    </div>
                    @if (_deleteError is not null)
                    {
                        <div class="mt-3"><ErrorAlert Message="@_deleteError" /></div>
                    }
                </AuthorizeView>
            }
        </Authorized>
    </AuthorizeView>
</main>

@code {
    private ProjectDto? _project;
    private bool _isLoading = true;
    private string? _errorMessage;

    private bool _isDeleting;
    private string? _deleteError;

    [Parameter] public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "page")] public int? PageParameter { get; set; }

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task DeleteAsync()
    {
        if (_project is null || !await JS.InvokeAsync<bool>(
                "confirm", $"Delete the project \"{_project.Title}\"? This can't be undone."))
        {
            return;
        }

        _isDeleting = true;
        _deleteError = null;
        try
        {
            await ProjectService.DeleteAsync(Id);
            Navigation.NavigateTo($"projects?page={PageParameter ?? 1}");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to delete project {ProjectId}.", Id);
            _deleteError = ApiErrors.ToMessage(exception, "Unable to delete the project.");
        }
        finally
        {
            _isDeleting = false;
        }
    }

    // Only http(s) URLs become links, so a stored javascript: URL can't run.
    private static string? SafeUrl(string? value) =>
        Uri.TryCreate(value, UriKind.Absolute, out var uri) &&
        (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
            ? uri.AbsoluteUri
            : null;

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _project = await ProjectService.GetByIdAsync(Id);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to load project {ProjectId}.", Id);
            _errorMessage = ApiErrors.ToMessage(exception, "Unable to load the project.");
        }
        finally
        {
            _isLoading = false;
        }
    }
}
