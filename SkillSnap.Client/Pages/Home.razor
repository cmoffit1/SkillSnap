@page "/"

<PageTitle>SkillSnap | Portfolio</PageTitle>

<main class="portfolio-page">
    <ProfileCard Name="Jordan Developer"
                 Bio="Full-stack developer passionate about learning new tech." />

    <ProjectList Projects="_projects" />

    <SkillTags Skills="_skills" />
</main>

@code {
    private static readonly IReadOnlyList<ProjectDisplayModel> _projects =
    [
        new("Task Tracker", "Manage tasks effectively."),
        new("Weather App", "Forecast weather using APIs.")
    ];

    private static readonly IReadOnlyList<SkillDisplayModel> _skills =
    [
        new("C#", "Advanced"),
        new("Blazor", "Intermediate")
    ];
}
