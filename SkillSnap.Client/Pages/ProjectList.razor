@page "/projects"
@using SkillSnap.Client.Services
@using SkillSnap.Client.Auth
@inject ProjectService ProjectService
@inject UserState UserState
@inject NavigationManager Navigation
@inject ILogger<ProjectList> Logger

<PageTitle>Projects | SkillSnap</PageTitle>

<main class="container py-4">
    <section aria-labelledby="projects-heading">
        <div class="d-flex align-items-end justify-content-between mb-4">
            <div>
                <p class="text-uppercase fw-bold text-info mb-1">Selected work</p>
                <h1 id="projects-heading" class="h2 mb-0">Projects</h1>
            </div>
            <AuthorizeView>
                <Authorized>
                    <a class="btn btn-primary" href="projects/new?page=@_page">Add project</a>
                </Authorized>
            </AuthorizeView>
        </div>

        <AuthorizeView>
            <NotAuthorized>
                <p class="text-secondary">Sign in to view and add projects.</p>
            </NotAuthorized>
            <Authorized Context="_">
                <AuthorizeView Roles="Admin" Context="adminView">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" role="switch" id="view-all"
                               checked="@UserState.ViewAll" disabled="@_isLoading"
                               @onchange="ToggleViewAllAsync" />
                        <label class="form-check-label" for="view-all">Show everyone's projects</label>
                    </div>
                </AuthorizeView>
                @if (_isLoading)
                {
                    <p role="status">Loading projects…</p>
                }
                else if (_errorMessage is not null)
                {
                    <ErrorAlert Message="@_errorMessage" OnRetry="LoadPageAsync" />
                }
                else if (_projects.Count == 0)
                {
                    <p class="text-secondary">No projects to show yet.</p>
                }
                else
                {
                    <div class="list-group list-striped shadow-sm">
                        @foreach (var project in _projects)
                        {
                            <a class="list-group-item list-group-item-action"
                               href="projects/@project.Id?page=@_page"
                               @key="project.Id">
                                <span class="fw-semibold">@project.Title</span>
                            </a>
                        }
                    </div>

                    <nav class="d-flex align-items-center justify-content-between mt-4"
                         aria-label="Project pages">
                        <button class="btn btn-outline-secondary"
                                disabled="@(_isLoading || _page <= 1)"
                                @onclick="PreviousPage">
                            Previous
                        </button>
                        <span aria-live="polite">Page @_page of @PageCount</span>
                        <button class="btn btn-outline-secondary"
                                disabled="@(_isLoading || _page >= PageCount)"
                                @onclick="NextPage">
                            Next
                        </button>
                    </nav>
                }
            </Authorized>
        </AuthorizeView>
    </section>
</main>

@code {
    private const int PageSize = 25;

    private IReadOnlyList<ProjectDto> _projects = [];
    private int _page = 1;
    private int _totalCount;
    private bool _isLoading = true;
    private string? _errorMessage;

    [SupplyParameterFromQuery(Name = "page")] public int? PageParameter { get; set; }

    private int PageCount => Math.Max(1, (int)Math.Ceiling((double)_totalCount / PageSize));

    protected override Task OnParametersSetAsync()
    {
        _page = Math.Max(1, PageParameter ?? 1);
        return LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await ProjectService.GetAsync(_page, PageSize, UserState.ViewAll);
            _projects = result.Items;
            _totalCount = result.TotalCount;
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to load projects from the API.");
            _errorMessage = ApiErrors.ToMessage(exception, "Unable to load projects.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleViewAllAsync(ChangeEventArgs args)
    {
        UserState.ViewAll = args.Value is true;
        if (_page == 1)
        {
            await LoadPageAsync();
        }
        else
        {
            Navigation.NavigateTo("projects");
        }
    }

    private void PreviousPage() => Navigation.NavigateTo($"projects?page={_page - 1}");

    private void NextPage() => Navigation.NavigateTo($"projects?page={_page + 1}");
}
