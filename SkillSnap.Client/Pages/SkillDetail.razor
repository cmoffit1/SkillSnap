@page "/skills/{Id:int}"
@using SkillSnap.Client.Services
@inject SkillService SkillService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<SkillDetail> Logger

<PageTitle>@(_skill?.Name ?? "Skill") | SkillSnap</PageTitle>

<main class="container py-4">
    <a class="btn btn-outline-primary mb-3" href="skills?page=@(PageParameter ?? 1)" aria-label="Back to skills">
        <span aria-hidden="true">&larr;</span> Back
    </a>

    <AuthorizeView>
        <NotAuthorized>
            <p class="text-secondary">Sign in to view this skill.</p>
        </NotAuthorized>
        <Authorized Context="_">
            @if (_isLoading)
            {
                <p role="status">Loading skill…</p>
            }
            else if (_errorMessage is not null)
            {
                <ErrorAlert Message="@_errorMessage" OnRetry="LoadAsync" />
            }
            else if (_skill is null)
            {
                <p class="text-secondary">That skill doesn't exist.</p>
            }
            else
            {
                <article class="card shadow-sm">
                    <div class="card-body">
                        <h1 class="card-title h3">@_skill.Name</h1>
                        @if (!string.IsNullOrWhiteSpace(_skill.Level))
                        {
                            <span class="badge text-bg-info">@_skill.Level</span>
                        }
                    </div>
                </article>

                <AuthorizeView Roles="Admin">
                    <div class="d-flex gap-2 mt-3">
                        <a class="btn btn-outline-primary @(_isDeleting ? "disabled" : null)"
                           href="skills/@Id/edit?page=@(PageParameter ?? 1)">Edit</a>
                        <button class="btn btn-outline-danger" type="button" disabled="@_isDeleting"
                                @onclick="DeleteAsync">
                            @(_isDeleting ? "Deleting…" : "Delete")
                        </button>
                    </div>
                    @if (_deleteError is not null)
                    {
                        <div class="mt-3"><ErrorAlert Message="@_deleteError" /></div>
                    }
                </AuthorizeView>
            }
        </Authorized>
    </AuthorizeView>
</main>

@code {
    private SkillDto? _skill;
    private bool _isLoading = true;
    private string? _errorMessage;

    private bool _isDeleting;
    private string? _deleteError;

    [Parameter] public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "page")] public int? PageParameter { get; set; }

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task DeleteAsync()
    {
        if (_skill is null || !await JS.InvokeAsync<bool>(
                "confirm", $"Delete the skill \"{_skill.Name}\"? This can't be undone."))
        {
            return;
        }

        _isDeleting = true;
        _deleteError = null;
        try
        {
            await SkillService.DeleteAsync(Id);
            Navigation.NavigateTo($"skills?page={PageParameter ?? 1}");
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to delete skill {SkillId}.", Id);
            _deleteError = ApiErrors.ToMessage(exception, "Unable to delete the skill.");
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _skill = await SkillService.GetByIdAsync(Id);
        }
        catch (HttpRequestException exception)
        {
            Logger.LogError(exception, "Failed to load skill {SkillId}.", Id);
            _errorMessage = ApiErrors.ToMessage(exception, "Unable to load the skill.");
        }
        finally
        {
            _isLoading = false;
        }
    }
}
